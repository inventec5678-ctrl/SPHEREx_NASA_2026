# training artefacts (the released model rb_cnn.pt and its metrics are kept)
models/rb_cnn.train.pt
models/test_scores.npz

# manuscripts, videos and submission bundles (built from paper_tex / paper_aas and scripts/demo_*.py)
*.pdf
*.mp4
*.zip

